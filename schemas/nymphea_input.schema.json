{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fumades.example/schemas/nymphea-input-v1.1.1.json",
  "title": "Fumades Nymphea planning input V1.1.1",
  "type": "object",
  "required": ["stays", "care_requests"],
  "properties": {
    "stays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stay_id", "client_ref", "start_date", "end_date",
          "primary_orientation", "earliest_start", "preferred_day_start", "latest_start"
        ],
        "properties": {
          "stay_id": {"type": "string", "minLength": 1},
          "client_ref": {"type": "string", "minLength": 1},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "primary_orientation": {"type": "string", "minLength": 1},
          "secondary_orientation": {"type": "string"},
          "package_primary": {"type": "string"},
          "package_secondary": {"type": "string"},
          "earliest_start": {"$ref": "#/$defs/gridTime"},
          "preferred_day_start": {"$ref": "#/$defs/gridTime"},
          "latest_start": {"$ref": "#/$defs/gridTime"},
          "preferred_start": {
            "description": "Champ V1.1 accepte uniquement pour compatibilite ascendante",
            "$ref": "#/$defs/gridTime"
          },
          "pmr_level": {"type": "integer", "minimum": 0},
          "planning_communicated": {"type": "boolean"}
        }
      }
    },
    "care_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["request_id", "stay_id", "service_date", "care_code", "sector", "mode_plan"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "stay_id": {"type": "string", "minLength": 1},
          "service_date": {"type": "string", "format": "date"},
          "care_code": {"type": "string", "minLength": 1},
          "sector": {"type": "string", "minLength": 1},
          "mode_plan": {"enum": ["AVEC_RESSOURCE", "SANS_CRENEAU"]},
          "preferred_start": {"oneOf": [{"$ref": "#/$defs/gridTime"}, {"type": "null"}]},
          "locked_start": {"oneOf": [{"$ref": "#/$defs/gridTime"}, {"type": "null"}]},
          "locked_resource": {"type": ["string", "null"]},
          "medical_override": {"type": "boolean"},
          "catchup_reason": {"type": ["string", "null"]}
        }
      }
    }
  },
  "$defs": {
    "gridTime": {
      "type": "string",
      "pattern": "^(?:[01]\\d|2[0-3]):(?:00|05|10|15|20|25|30|35|40|45|50|55)$"
    }
  }
}
