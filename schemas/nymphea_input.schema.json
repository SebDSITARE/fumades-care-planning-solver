{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thermes-fumades.local/schemas/nymphea-input-v1.2.json",
  "title": "Entree normalisee Nymphea - Solveur Fumades V1.2",
  "type": "object",
  "required": ["stays", "care_requests"],
  "properties": {
    "stays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stay_id", "client_ref", "start_date", "end_date", "primary_orientation", "package_primary"],
        "properties": {
          "stay_id": {"type": "string", "minLength": 1},
          "client_ref": {"type": "string", "description": "Identifiant pseudonymise; ne jamais utiliser le nom du curiste"},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "primary_orientation": {"enum": ["RH", "DER", "VR"]},
          "secondary_orientation": {"enum": ["", "RH", "DER", "VR"]},
          "package_primary": {"type": "string"},
          "package_secondary": {"type": "string"},
          "earliest_start": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
          "preferred_day_start": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
          "latest_start": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
          "preferred_start": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
          "pmr_level": {"type": "string"},
          "planning_communicated": {"type": "boolean"},
          "couple_id": {"type": "string", "description": "Identifiant pseudonymise commun aux deux sejours"},
          "couple_role": {"enum": ["", "A", "B"]},
          "wave_id": {"type": "string"}
        }
      }
    },
    "care_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["request_id", "stay_id", "service_date", "care_code", "sector", "mode_plan"],
        "properties": {
          "request_id": {"type": "string"},
          "stay_id": {"type": "string"},
          "service_date": {"type": "string", "format": "date"},
          "care_code": {"type": "string"},
          "sector": {"enum": ["RH", "DER", "VR"]},
          "mode_plan": {"enum": ["AVEC_RESSOURCE", "SANS_CRENEAU", "REPOS", "ENTREE"]},
          "preferred_start": {"type": "string"},
          "locked_start": {"type": "string"},
          "locked_resource": {"type": "string"},
          "medical_override": {"type": "boolean"},
          "catchup_reason": {"type": "string"},
          "couple_sync_group": {"type": "string", "description": "Identifiant pseudonymise d'une paire de soins a rapprocher"},
          "couple_sync_priority": {"enum": ["", "NONE", "PREFERRED", "COLLECTIVE"]}
        }
      }
    }
  },
  "additionalProperties": false
}
